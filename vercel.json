{
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "bookkeep.burse.co.za" }],
      "dest": "/bookkeeping-admin.html"
    },
    { "handle": "filesystem" },
    { "src": "/([^./]+)$", "dest": "/$1.html", "check": true }
  ]
}
